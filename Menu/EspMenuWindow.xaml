<Window x:Class="Bikuida.Menu.EspMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bikuida Project"
        Width="280"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        Background="#141417"
        Foreground="#C8C8D2"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="True"
        Topmost="False"
        WindowStyle="None"
        Opacity="0.98"
        AllowsTransparency="True">

    <Window.Resources>

        <Style x:Key="ToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width"  Value="36"/>
            <Setter Property="Height" Value="19"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" CornerRadius="9" Background="#30303C"/>
                            <Ellipse x:Name="Thumb" Width="13" Height="13"
                                     Fill="#666672" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track"  Property="Background" Value="#1A3355"/>
                                <Setter TargetName="Thumb"  Property="Fill"       Value="#3389FF"/>
                                <Setter TargetName="Thumb"  Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb"  Property="Margin"     Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwatchStyle" TargetType="Button">
            <Setter Property="Width"           Value="18"/>
            <Setter Property="Height"          Value="18"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                BorderBrush="#1FFFFFFF"
                                BorderThickness="0.5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowStyle" TargetType="DockPanel">
            <Setter Property="Height"        Value="28"/>
            <Setter Property="Margin"        Value="0,1,0,1"/>
            <Setter Property="LastChildFill" Value="False"/>
        </Style>

        <Style x:Key="RowLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="#A8A8B8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize"          Value="12"/>
        </Style>

        <Style x:Key="SepStyle" TargetType="Separator">
            <Setter Property="Background" Value="#252530"/>
            <Setter Property="Height"     Value="0.5"/>
            <Setter Property="Margin"     Value="0,10,0,10"/>
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#44444E"/>
            <Setter Property="Margin"     Value="0,6,0,8"/>
        </Style>
        
        <Style x:Key="ColHeadEnemyStyle" TargetType="Border">
            <Setter Property="Background"   Value="#1E1414"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding"      Value="10,5"/>
            <Setter Property="Margin"       Value="0,0,0,8"/>
        </Style>
        
        <Style x:Key="ColHeadTeamStyle" TargetType="Border">
            <Setter Property="Background"   Value="#111A26"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding"      Value="10,5"/>
            <Setter Property="Margin"       Value="0,0,0,8"/>
        </Style>
        
        <Style x:Key="BetaStyle" TargetType="Border">
            <Setter Property="Background"      Value="#1E2A1A"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="Padding"         Value="4,1"/>
            <Setter Property="Margin"          Value="5,0,0,0"/>
            <Setter Property="BorderBrush"     Value="#2A4A2A"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GlobalCardStyle" TargetType="Border">
            <Setter Property="Background"      Value="#1A1A1F"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="BorderBrush"     Value="#2E2E38"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding"         Value="6,5"/>
        </Style>

    </Window.Resources>

    <StackPanel Margin="16,14,16,18">

        <Border Background="#101013"
                BorderBrush="#2A2A32"
                BorderThickness="0,0,0,0.5"
                MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid Margin="18,12,18,12">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="Bikuida Project"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#E2E2EA"/>
                    <TextBlock Text="v3.3 · ESP Module"
                               FontSize="11" Foreground="#555560"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#1E2A3A" CornerRadius="20"
                        BorderBrush="#1E3560" BorderThickness="0.5"
                        Padding="8,2">
                    <TextBlock Text="WALL HACK"
                               FontSize="10" FontWeight="Bold"
                               Foreground="#3389FF"/>
                </Border>
            </Grid>
        </Border>

        <StackPanel Margin="5,14,5,18">

            <!-- Global Toggles -->

            <Border Grid.Column="0" Style="{StaticResource GlobalCardStyle}">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚠" FontSize="14" Margin="0,0,6,0"
                                       VerticalAlignment="Center" Foreground="#FF6B6B"/>
                        <TextBlock Text="Show Enemies" FontSize="12"
                                       Foreground="#C8C8D2" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleStyle}"
                                      IsChecked="{Binding ShowEnemy, Mode=TwoWay}"/>
                </DockPanel>
            </Border>

        </StackPanel>

        <StackPanel Margin="0" IsEnabled="{Binding ShowEnemy, Mode=TwoWay}">
            <Border Style="{StaticResource ColHeadEnemyStyle}">
                <TextBlock Text="ENEMY" FontSize="11" FontWeight="Bold" Foreground="#FF6B6B"/>
            </Border>

            <DockPanel Style="{StaticResource RowStyle}">
                <TextBlock Text="Skeleton" Style="{StaticResource RowLabelStyle}"/>
                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleStyle}"
                                    IsChecked="{Binding ShowEnemySkeleton, Mode=TwoWay}"/>
                <Button DockPanel.Dock="Right" Margin="0,0,6,0"
                            Style="{StaticResource SwatchStyle}"
                            Background="{Binding EnemySkeletonColor}"
                            Click="Swatch_Click" Tag="EnemySkeletonColor"/>
            </DockPanel>

            <DockPanel Style="{StaticResource RowStyle}">
                <TextBlock Text="Box" Style="{StaticResource RowLabelStyle}"/>
                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleStyle}"
                                    IsChecked="{Binding ShowEnemyBox, Mode=TwoWay}"/>
                <Button DockPanel.Dock="Right" Margin="0,0,6,0"
                            Style="{StaticResource SwatchStyle}"
                            Background="{Binding EnemyBoxColor}"
                            Click="Swatch_Click" Tag="EnemyBoxColor"/>
            </DockPanel>

            <DockPanel Style="{StaticResource RowStyle}">
                <TextBlock Text="Name" Style="{StaticResource RowLabelStyle}"/>
                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleStyle}"
                                    IsChecked="{Binding ShowEnemyName, Mode=TwoWay}"/>
                <Button DockPanel.Dock="Right" Margin="0,0,6,0"
                            Style="{StaticResource SwatchStyle}"
                            Background="{Binding EnemyNameColor}"
                            Click="Swatch_Click" Tag="EnemyNameColor"/>
            </DockPanel>

            <DockPanel Style="{StaticResource RowStyle}">
                <TextBlock Text="Health" Style="{StaticResource RowLabelStyle}"/>
                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleStyle}"
                                    IsChecked="{Binding ShowEnemyHealth, Mode=TwoWay}"/>
                <Button DockPanel.Dock="Right" Margin="0,0,6,0"
                            Style="{StaticResource SwatchStyle}"
                            Background="{Binding EnemyHealthColor}"
                            Click="Swatch_Click" Tag="EnemyHealthColor"/>
            </DockPanel>

            <DockPanel Style="{StaticResource RowStyle}">
                <TextBlock Text="Lines" Style="{StaticResource RowLabelStyle}"/>
                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleStyle}"
                                    IsChecked="{Binding ShowEnemyLines, Mode=TwoWay}"/>
                <Button DockPanel.Dock="Right" Margin="0,0,6,0"
                            Style="{StaticResource SwatchStyle}"
                            Background="{Binding EnemyLinesColor}"
                            Click="Swatch_Click" Tag="EnemyLinesColor"/>
            </DockPanel>

            <DockPanel Style="{StaticResource RowStyle}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Weapon" Style="{StaticResource RowLabelStyle}"/>
                    <Border Style="{StaticResource BetaStyle}">
                        <TextBlock Text="BETA" FontSize="9" FontWeight="Bold" Foreground="#66BB6A"/>
                    </Border>
                </StackPanel>
                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleStyle}"
                                    IsChecked="{Binding ShowEnemyWeapon, Mode=TwoWay}"/>
                <Button DockPanel.Dock="Right" Margin="0,0,6,0"
                            Style="{StaticResource SwatchStyle}"
                            Background="{Binding EnemyWeaponColor}"
                            Click="Swatch_Click" Tag="EnemyWeaponColor"/>
            </DockPanel>

            <DockPanel Style="{StaticResource RowStyle}" Height="45" Margin="0,5,0,0">
                <StackPanel Width="248">
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Opacity" FontSize="12" Foreground="#C8C8D2" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right"
                                    Margin="10,0,0,0"
                                    FontSize="12" Foreground="#3389FF"
                                    VerticalAlignment="Center">
                <Run Text="{Binding Opacity, StringFormat={}{0:F0}}" FontWeight="Bold"/>
                        </TextBlock>
                    </DockPanel>
                    <Slider Minimum="0" Maximum="100"
                            Margin="0,4,0,0"
                            Value="{Binding Opacity, Mode=TwoWay}"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Foreground="#3389FF"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </DockPanel>

            <DockPanel Style="{StaticResource RowStyle}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Trigger" Style="{StaticResource RowLabelStyle}"/>
                    <Border Style="{StaticResource BetaStyle}">
                        <TextBlock Text="BETA" FontSize="9" FontWeight="Bold" Foreground="#66BB6A"/>
                    </Border>
                </StackPanel>
                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleStyle}"
                        IsChecked="{Binding UseEnemyTrigger, Mode=TwoWay}"/>
                <Button DockPanel.Dock="Right" Margin="0,0,6,0"
                        Style="{StaticResource SwatchStyle}"
                        Background="{Binding UseEnemyTriggerColor}"
                        Click="Swatch_Click" Tag="EnemyTriggerColor"/>
            </DockPanel>

            <DockPanel Style="{StaticResource RowStyle}" Height="45" Margin="0,5,0,0">
                <StackPanel Width="248">
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Trigger FOV Radius (Aspas ')" FontSize="12"
                                   Foreground="#C8C8D2" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right"
                                   Margin="10,0,0,0"
                                    FontSize="12" Foreground="#3389FF"
                                    VerticalAlignment="Center">
                            <Run Text="{Binding Fov, StringFormat={}{0:F0}}" FontWeight="Bold"/>
                        </TextBlock>
                    </DockPanel>
                    <Slider Minimum="0" Maximum="30"
                            Margin="0,4,0,0"
                            Value="{Binding Fov, Mode=TwoWay}"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Foreground="#3389FF"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </DockPanel>

            <DockPanel Style="{StaticResource RowStyle}">
                <TextBlock Text="Aimbot" Style="{StaticResource RowLabelStyle}"/>
                <Border Style="{StaticResource BetaStyle}">
                    <TextBlock Text="BETA" FontSize="9" FontWeight="Bold" Foreground="#66BB6A"/>
                </Border>
                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleStyle}"
                    IsChecked="{Binding UseAimbot, Mode=TwoWay}"/>
            </DockPanel>

            <DockPanel Style="{StaticResource RowStyle}" Height="45" Margin="0,5,0,0">
                <StackPanel Width="248">
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Aimbot FOV Radius (ALT)" FontSize="12"
                                    Foreground="#C8C8D2" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right"
                                    Margin="10,0,0,0"
                                    FontSize="12" Foreground="#3389FF"
                                    VerticalAlignment="Center">
                <Run Text="{Binding AimbotFov, StringFormat={}{0:F0}}" FontWeight="Bold"/>
                        </TextBlock>
                    </DockPanel>
                    <Slider Minimum="10" Maximum="70"
                            Margin="0,4,0,0"
                            Value="{Binding AimbotFov, Mode=TwoWay}"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Foreground="#3389FF"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <Separator Style="{StaticResource SepStyle}" Margin="0,14,0,0"/>
    </StackPanel>
</Window>
